// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  password  String    // Added for authentication
  phone     String?
  role      String    @default("CUSTOMER") // CUSTOMER, AGENT, ADMIN
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  policies  Policy[]
  claims    Claim[]
  documents Document[]
  auditLogs AuditLog[]
  
  // Indexes for optimization
  @@index([role])
  @@index([createdAt])
  @@index([role, createdAt])
  @@map("users")
}

model Bus {
  id            Int       @id @default(autoincrement())
  registrationNumber String @unique
  make          String
  model         String
  year          Int
  capacity      Int
  engineNumber  String?
  chassisNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  policies      Policy[]
  
  @@map("buses")
}

model Policy {
  id            Int           @id @default(autoincrement())
  policyNumber  String        @unique
  userId        Int
  busId         Int
  startDate     DateTime
  endDate       DateTime
  premium       Decimal       @db.Decimal(10, 2)
  coverage      Decimal       @db.Decimal(12, 2)
  status        String        @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, SUSPENDED
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relations
  user          User          @relation(fields: [userId], references: [id])
  bus           Bus           @relation(fields: [busId], references: [id])
  claims        Claim[]
  documents     Document[]
  
  // Indexes for optimization
  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([endDate])
  @@map("policies")
}

model Claim {
  id            Int         @id @default(autoincrement())
  claimNumber   String      @unique
  userId        Int
  policyId      Int
  incidentDate  DateTime
  description   String
  amount        Decimal     @db.Decimal(10, 2)
  status        String      @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSING, SETTLED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  user          User        @relation(fields: [userId], references: [id])
  policy        Policy      @relation(fields: [policyId], references: [id])
  documents     Document[]
  payment       Payment?
  
  // Indexes for optimization
  @@index([userId])
  @@index([policyId])
  @@index([status])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([incidentDate])
  @@map("claims")
}

model Document {
  id          Int      @id @default(autoincrement())
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String?
  uploadedBy  Int
  claimId     Int?
  policyId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [uploadedBy], references: [id])
  claim       Claim?   @relation(fields: [claimId], references: [id])
  policy      Policy?  @relation(fields: [policyId], references: [id])
  
  // Indexes for optimization
  @@index([uploadedBy])
  @@index([claimId])
  @@index([policyId])
  @@index([createdAt])
  @@map("documents")
}

model Payment {
  id            Int      @id @default(autoincrement())
  claimId       Int      @unique
  amount        Decimal  @db.Decimal(10, 2)
  method        String   // BANK_TRANSFER, CHECK, DIGITAL_WALLET
  status        String   @default("PENDING") // PENDING, PROCESSED, FAILED, CANCELLED
  transactionId String?  @unique
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  claim         Claim    @relation(fields: [claimId], references: [id])
  
  // Indexes for optimization
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // CLAIM_CREATED, CLAIM_APPROVED, PAYMENT_PROCESSED, etc.
  entityType String  // CLAIM, POLICY, USER, PAYMENT
  entityId  Int
  userId    Int
  details   String?  // JSON string with additional details
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  
  // Indexes for optimization
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}